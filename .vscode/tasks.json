{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev client",
      "type": "shell",
      "command": "bash",
      "args": ["-i", "-c", "yarn run dev:client"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "group": "ws-lab"
      }
    },
    {
      "label": "Dev server",
      "type": "shell",
      "command": "bash",
      "args": ["-i", "-c", "yarn run dev:server"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "group": "ws-lab"
      }
    },
    {
      "label": "Dev",
      "dependsOn": ["Dev client", "Dev server"],
      "problemMatcher": ["$eslint-stylish", "$tsc"]
    }
  ]
}
